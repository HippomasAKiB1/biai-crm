# LLM provider — OpenRouter's OpenAI-compatible endpoint (swap by changing these three)
LLM_PROVIDER=openrouter
LLM_MODEL=anthropic/claude-3.5-sonnet
LLM_API_KEY=replace-me
LLM_BASE_URL=https://openrouter.ai/api/v1
# CORS — comma-separated origins. Set to your deployed frontend URL.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Backend
DATABASE_URL=sqlite:///./biai_crm.db
DEMO_DATE=2026-11-01T00:00:00
# Frontend
NEXT_PUBLIC_API_URL=http://localhost:8000
